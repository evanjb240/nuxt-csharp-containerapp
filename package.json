{
  "name": "sample-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "cd ./client && npm run build",
    "dev:client": "cd ./client && npm run dev",
    "dev:api": "cd ./api && ASPNETCORE_ENVIRONMENT=Development dotnet watch --no-hot-reload",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:api\"",
    "production:client": "cd ./client && npm run generate",
    "production:api": "dotnet publish ./api/sample-app.csproj -o ./artifacts",
    "production": "npm run production:client && npm run production:api",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}